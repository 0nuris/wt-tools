#!/usr/bin/env bash
# wt-link — symlink shareable gitignored artifacts from a repo's main checkout
#           into a linked worktree (node_modules, .env, config, ...).
#
# Idempotent: re-running reconciles and repairs. Never clobbers real files;
# emits human-run commands for blocked ops (install, rm -rf of a real dir).
#
# Usage:
#   wt-link [WORKTREE_PATH] [--dry-run] [--quiet] [-h|--help]
#
# Exit: 0 reconciled; 1 human action pending; 2 usage / not a worktree.

set -euo pipefail

WT_TOOLS_CONFIG="${WT_TOOLS_CONFIG:-$HOME/.config/wt-tools/wt-tools.conf}"
# shellcheck source=/dev/null
[[ -f "$WT_TOOLS_CONFIG" ]] && . "$WT_TOOLS_CONFIG"

# ---- flag parsing --------------------------------------------------------
DRY_RUN=0
QUIET=0
TARGET=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --quiet)   QUIET=1; shift ;;
    --help|-h) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "wt-link: unknown flag: $1" >&2; exit 2 ;;
    *)
      if [[ -z "$TARGET" ]]; then TARGET="$1"; shift
      else echo "wt-link: unexpected argument: $1" >&2; exit 2; fi ;;
  esac
done
TARGET="${TARGET:-$PWD}"

# ---- resolve worktree + main checkout ------------------------------------
if ! git -C "$TARGET" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "wt-link: $TARGET is not inside a git repository." >&2
  exit 2
fi
WT_DIR="$(git -C "$TARGET" rev-parse --show-toplevel)"
MAIN_DIR="$(git -C "$TARGET" worktree list --porcelain \
            | awk '/^worktree /{print substr($0,10); exit}')"
if [[ -z "$MAIN_DIR" || ! -d "$MAIN_DIR" ]]; then
  echo "wt-link: could not locate the main checkout for $WT_DIR." >&2
  exit 2
fi
if [[ "$WT_DIR" == "$MAIN_DIR" ]]; then
  echo "wt-link: $WT_DIR is the main checkout — it's the source, nothing to link." >&2
  echo "         Run wt-link from inside a linked worktree." >&2
  exit 2
fi

# ---- per-repo config + knob defaults -------------------------------------
# shellcheck source=/dev/null
[[ -f "$MAIN_DIR/.wt-tools.conf" ]] && . "$MAIN_DIR/.wt-tools.conf"
# shellcheck source=/dev/null
[[ -f "$MAIN_DIR/.wt-tools.local.conf" ]] && . "$MAIN_DIR/.wt-tools.local.conf"
: "${WT_LINK_AUTO:=true}"
: "${WT_LINK_PATHS:=}"
: "${WT_LINK_EXCLUDE:=}"

# ---- denylist ------------------------------------------------------------
BUILTIN_DENY=(.next .nuxt .svelte-kit dist build out .output coverage .turbo \
              .cache .parcel-cache .vite .pytest_cache __pycache__ '*.log' \
              .DS_Store Thumbs.db)
USER_DENY=()
# shellcheck disable=SC2206
[[ -n "$WT_LINK_EXCLUDE" ]] && USER_DENY=( $WT_LINK_EXCLUDE )
DENY=( "${BUILTIN_DENY[@]}" "${USER_DENY[@]+"${USER_DENY[@]}"}" )

is_denied() {
  local name="$1" pat
  for pat in "${DENY[@]}"; do
    # shellcheck disable=SC2053
    [[ "$name" == $pat ]] && return 0
  done
  return 1
}

# ---- build candidate set -------------------------------------------------
CANDIDATES=()
add_candidate() {
  local c="$1" e
  if (( ${#CANDIDATES[@]} )); then
    for e in "${CANDIDATES[@]}"; do [[ "$e" == "$c" ]] && return 0; done
  fi
  CANDIDATES+=("$c")
}

if [[ "$WT_LINK_AUTO" == "true" ]]; then
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    entry="${entry%/}"
    [[ "$entry" == */* ]] && continue        # root-level only
    is_denied "$entry" && continue
    add_candidate "$entry"
  done < <(git -C "$MAIN_DIR" ls-files --others --ignored --exclude-standard --directory)
fi

# shellcheck disable=SC2206
[[ -n "$WT_LINK_PATHS" ]] && for entry in $WT_LINK_PATHS; do add_candidate "$entry"; done

# Expected-but-absent guard: a Node repo with no installed deps in main.
if [[ -f "$MAIN_DIR/package.json" && ! -e "$MAIN_DIR/node_modules" ]]; then
  add_candidate "node_modules"
fi

# ---- reconcile -----------------------------------------------------------
# Physical (symlink-resolved) paths; used in the ancestor guard.
# MAIN_DIR from git may not be symlink-resolved on macOS (e.g. /tmp vs /private/tmp),
# so normalise both to avoid string-mismatch false conflicts.
MAIN_REAL="$(cd "$MAIN_DIR" && pwd -P)"
WT_REAL="$(cd "$WT_DIR" && pwd -P)"

created=0; repaired=0; ok=0; conflicts=0; pending=0
INFO=(); PROBLEM=()
note_info()    { INFO+=("$1"); }
note_problem() { PROBLEM+=("$1"); }

# Guarantee a just-created symlink is git-ignored in the worktree. A dir-only
# .gitignore rule (node_modules/) does NOT ignore a symlink, so we add a bare
# pattern to the repo's untracked exclude file and re-verify.
ensure_ignored() {
  local entry="${1%/}" excl
  git -C "$WT_DIR" check-ignore -q "$entry" 2>/dev/null && return 0
  excl="$(git -C "$WT_DIR" rev-parse --git-path info/exclude)"
  mkdir -p "$(dirname "$excl")"
  grep -qxF "$entry" "$excl" 2>/dev/null || printf '%s\n' "$entry" >> "$excl"
  if git -C "$WT_DIR" check-ignore -q "$entry" 2>/dev/null; then
    note_info "ignore-guard: added '$entry' to $excl (was committable under a dir-only rule)"
    return 0
  fi
  note_problem "WARNING: $WT_DIR/$entry is NOT git-ignored and could be committed —"
  note_problem "  add an ignore rule for '$entry' with no trailing slash."
  pending=$((pending+1))
  return 1
}

detect_pm() {
  if   [[ -f "$MAIN_DIR/pnpm-lock.yaml" ]]; then echo pnpm
  elif [[ -f "$MAIN_DIR/yarn.lock" ]];      then echo yarn
  elif [[ -f "$MAIN_DIR/bun.lockb" ]];      then echo bun
  else echo npm; fi
}

link_one() {
  local entry="$1" src="$MAIN_DIR/$1" dst="$WT_DIR/$1"

  if [[ ! -e "$src" && ! -L "$src" ]]; then
    if [[ "$entry" == "node_modules" ]]; then
      local pm; pm="$(detect_pm)"
      note_problem "pending: main has no node_modules — wt-link can't install it (blocked)."
      note_problem "  run once, then re-run wt-link:"
      note_problem "    ! (cd \"$MAIN_DIR\" && $pm install)"
    else
      note_problem "pending: \"$entry\" not found in main ($MAIN_DIR) — cannot link."
    fi
    pending=$((pending+1))
    return
  fi

  if [[ -L "$dst" ]]; then
    local cur; cur="$(readlink "$dst")"
    if [[ "$cur" == "$src" ]]; then ok=$((ok+1)); return; fi
    if (( DRY_RUN )); then note_info "would repair: $dst -> $src (was $cur)"
    else rm "$dst"; mkdir -p "$(dirname "$dst")"; ln -s "$src" "$dst"
         note_info "repaired: $dst -> $src"; ensure_ignored "$entry"; fi
    repaired=$((repaired+1)); return
  fi

  # Ancestor-link guard: if dst's parent already resolves into MAIN_REAL (via a
  # symlinked ancestor), the target is already shared — not a conflict.
  # Exclude the worktree's own directory subtree (WT_REAL), which is physically
  # under MAIN_REAL when worktrees are nested inside the main checkout.
  local parent_real=""
  local parent; parent="$(dirname "$dst")"
  if [[ -d "$parent" ]]; then
    parent_real="$(cd "$parent" && pwd -P)" || parent_real=""
  fi
  if [[ -n "$parent_real" \
        && ( "$parent_real" == "$MAIN_REAL" || "$parent_real" == "$MAIN_REAL"/* ) \
        && "$parent_real" != "$WT_REAL" && "$parent_real" != "$WT_REAL"/* ]]; then
    ok=$((ok+1))
    note_info "ok (shared via linked parent): $entry"
    return
  fi

  if [[ -e "$dst" ]]; then
    conflicts=$((conflicts+1))
    if [[ -d "$dst" ]]; then
      note_problem "conflict: $dst is a real dir, not a link to main — left as-is."
      note_problem "  replace it with the shared copy from main:"
      # Belt-and-suspenders: never emit rm when dst resolves into MAIN_REAL
      # but outside the worktree's own subtree (WT_REAL is physically under MAIN_REAL
      # when worktrees are nested).
      local dst_real; dst_real="$(cd "$dst" && pwd -P 2>/dev/null)" || dst_real=""
      if [[ -n "$dst_real" \
            && ( "$dst_real" == "$MAIN_REAL" || "$dst_real" == "$MAIN_REAL"/* ) \
            && "$dst_real" != "$WT_REAL" && "$dst_real" != "$WT_REAL"/* ]]; then
        note_problem "  (rm skipped — path resolves into the main checkout)"
      else
        note_problem "    ! rm -rf \"$dst\" && wt-link \"$WT_DIR\""
      fi
    else
      note_problem "conflict: $dst is a real file, not a link to main — left as-is."
      note_problem "  replace it with the shared copy from main:"
      # Belt-and-suspenders: never emit rm when dst resolves into MAIN_REAL.
      local dst_dir_real; dst_dir_real="$(cd "$(dirname "$dst")" && pwd -P 2>/dev/null)" || dst_dir_real=""
      if [[ -n "$dst_dir_real" \
            && ( "$dst_dir_real" == "$MAIN_REAL" || "$dst_dir_real" == "$MAIN_REAL"/* ) \
            && "$dst_dir_real" != "$WT_REAL" && "$dst_dir_real" != "$WT_REAL"/* ]]; then
        note_problem "  (rm skipped — path resolves into the main checkout)"
      else
        note_problem "    ! rm -f \"$dst\" && wt-link \"$WT_DIR\""
      fi
    fi
    return
  fi

  if (( DRY_RUN )); then note_info "would link: $dst -> $src"
  else mkdir -p "$(dirname "$dst")"; ln -s "$src" "$dst"
       note_info "linked: $dst -> $src"; ensure_ignored "$entry"; fi
  created=$((created+1))
}

if (( ${#CANDIDATES[@]} )); then
  for entry in "${CANDIDATES[@]}"; do link_one "$entry"; done
fi

# ---- output --------------------------------------------------------------
if (( ${#PROBLEM[@]} )); then printf '%s\n' "${PROBLEM[@]}" >&2; fi
if (( ! QUIET )) && (( ${#INFO[@]} )); then printf '%s\n' "${INFO[@]}"; fi
(( QUIET )) || echo "wt-link: created $created, repaired $repaired, ok $ok, conflicts $conflicts, pending $pending"

(( conflicts + pending > 0 )) && exit 1 || exit 0
