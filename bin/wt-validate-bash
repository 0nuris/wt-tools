#!/usr/bin/env bash
# wt-validate-bash — Claude Code PreToolUse hook validator for Bash commands.
#
# Reads stdin JSON, extracts .tool_input.command, applies the rule named in
# $WT_TOOLS_RULE, and writes a permissionDecision JSON to stdout when blocking.
# Exit 0 always (deny is signalled via JSON, not exit code).
#
# Threat model: token-level matching after whitespace splitting. Catches direct
# invocations the model normally produces. Does NOT catch heredocs, bash -c
# strings, string-constructed commands, or aliases. See README.

set -euo pipefail

# ---- read input ----------------------------------------------------------
# Rule is passed as $1, with $WT_TOOLS_RULE as a fallback (for invocation styles
# that prefer env vars). Either works.
input="$(cat)"
command="$(printf '%s' "$input" | jq -r '.tool_input.command // empty')"
session_cwd="$(printf '%s' "$input" | jq -r '.cwd // empty')"
rule="${1:-${WT_TOOLS_RULE:-}}"

# If we can't process, defer to normal permission flow.
if [[ -z "$command" || -z "$rule" ]]; then
  exit 0
fi

# ---- scope check --------------------------------------------------------
# By default, only enforce rules when the session cwd is inside a *linked*
# git worktree (GIT_DIR != GIT_COMMON_DIR). Main checkouts, non-git dirs,
# and parent orchestrator dirs all defer.
#
# Set WT_ENFORCE_SCOPE=all (in config or env) to enforce everywhere.
WT_TOOLS_CONFIG="${WT_TOOLS_CONFIG:-$HOME/.config/wt-tools/wt-tools.conf}"
# shellcheck source=/dev/null
[[ -f "$WT_TOOLS_CONFIG" ]] && . "$WT_TOOLS_CONFIG"

# Per-repo config layering: when cwd is inside a git repo, walk up to find
# the repo root (or, if inside a linked worktree, its common-dir's parent)
# and source .wt-tools.conf then .wt-tools.local.conf if present.
if [[ -n "${session_cwd:-}" ]]; then
  _repo_root=""
  if _common="$(cd "$session_cwd" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null)"; then
    if [[ -n "$_common" && "$_common" != /* ]]; then
      _common="$(cd "$session_cwd" && cd "$_common" 2>/dev/null && pwd -P || true)"
    fi
    [[ -n "$_common" ]] && _repo_root="$(dirname "$_common")"
  fi
  if [[ -n "$_repo_root" ]]; then
    # shellcheck source=/dev/null
    [[ -f "$_repo_root/.wt-tools.conf" ]] && . "$_repo_root/.wt-tools.conf"
    # shellcheck source=/dev/null
    [[ -f "$_repo_root/.wt-tools.local.conf" ]] && . "$_repo_root/.wt-tools.local.conf"
  fi
fi

: "${WT_ENFORCE_SCOPE:=worktree}"

if [[ "$WT_ENFORCE_SCOPE" != "all" ]]; then
  if [[ -z "$session_cwd" ]]; then
    # No cwd reported → can't determine scope → defer to be safe.
    exit 0
  fi

  git_dir="$(git -C "$session_cwd" rev-parse --absolute-git-dir 2>/dev/null || true)"
  if [[ -z "$git_dir" ]]; then
    # Not a git repo → not a worktree → defer.
    exit 0
  fi

  # Submodule guard: a submodule has GIT_DIR != GIT_COMMON_DIR too, but that
  # is "inside a submodule of a main checkout", not a linked worktree of the
  # current repo. Treat submodules as main-session for enforcement purposes.
  superproject="$(git -C "$session_cwd" rev-parse --show-superproject-working-tree 2>/dev/null || true)"
  if [[ -n "$superproject" ]]; then
    exit 0
  fi

  git_common="$(cd "$session_cwd" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null || true)"
  if [[ -n "$git_common" && "$git_common" != /* ]]; then
    git_common="$(cd "$session_cwd" && cd "$git_common" 2>/dev/null && pwd -P || true)"
  fi

  if [[ -z "$git_common" || "$git_dir" == "$git_common" ]]; then
    # Main checkout (GIT_DIR == GIT_COMMON_DIR) → defer.
    exit 0
  fi
  # Otherwise: linked worktree → continue to rule logic below.
fi

# ---- helpers -------------------------------------------------------------
deny() {
  local reason="$1"
  jq -n --arg reason "$reason" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
  exit 0
}

# Token-presence check (exact match).
has_token() {
  local target="$1"; shift
  local t
  for t in "$@"; do
    if [[ "$t" == "$target" ]]; then
      return 0
    fi
  done
  return 1
}

# Defensive sanity check: confirm the rule's target command (e.g. "gh pr create")
# actually appears as a sequence of consecutive tokens in the command. If it
# does not, the if-filter routed the wrong command here and we defer. Belt-and-
# suspenders against any Claude Code matcher quirk in compound commands.
has_token_sequence() {
  # Args: -- t1 t2 t3 ... -- tokens...
  local -a target=() pool=()
  local in_target=1 a
  for a in "$@"; do
    if [[ "$in_target" -eq 1 ]]; then
      if [[ "$a" == "--" ]]; then in_target=0; else target+=("$a"); fi
    else
      pool+=("$a")
    fi
  done

  local n=${#target[@]} m=${#pool[@]}
  (( n == 0 || m < n )) && return 1

  local i j ok
  for (( i=0; i<=m-n; i++ )); do
    ok=1
    for (( j=0; j<n; j++ )); do
      if [[ "${pool[i+j]}" != "${target[j]}" ]]; then ok=0; break; fi
    done
    (( ok )) && return 0
  done
  return 1
}

# ---- tokenize ------------------------------------------------------------
# Word-split on whitespace. Best-effort; quoted args may be partial tokens,
# but that's acceptable for our flag-presence checks (--draft, --force).
read -ra tokens <<< "$command"

# ---- strip leading env-var assignments, recording bypasses ---------------
bypass_nondraft=""
bypass_merge=""
bypass_force=""

while [[ ${#tokens[@]} -gt 0 ]]; do
  case "${tokens[0]}" in
    WT_ALLOW_NONDRAFT=1|WT_ALLOW_NONDRAFT=true)
      bypass_nondraft=1
      tokens=("${tokens[@]:1}")
      ;;
    WT_ALLOW_MERGE=1|WT_ALLOW_MERGE=true)
      bypass_merge=1
      tokens=("${tokens[@]:1}")
      ;;
    WT_ALLOW_FORCE=1|WT_ALLOW_FORCE=true)
      bypass_force=1
      tokens=("${tokens[@]:1}")
      ;;
    *=*)
      # Some other inline env-var assignment (e.g. DEBUG=1). Skip past it.
      tokens=("${tokens[@]:1}")
      ;;
    *)
      break
      ;;
  esac
done

# ---- per-rule check helpers ----------------------------------------------
# Each helper takes the token list as positional args and either returns 0
# (no match / bypass / safe) or calls deny() (which exits with the JSON
# payload). They read the bypass_* variables set during the env-stripping
# pass above. Sharing these helpers between the direct rules and the
# inspect-wrapped rule means the rule signatures and deny messages live in
# one place.

check_draft_prs() {
  local -a t=("$@")
  has_token_sequence gh pr create -- "${t[@]:-}" || return 0
  [[ -n "$bypass_nondraft" ]] && return 0
  has_token "--draft" "${t[@]:-}" && return 0
  deny "wt-tools: draft PRs only. Add --draft to the command, or prefix it with WT_ALLOW_NONDRAFT=1 to bypass for this single invocation."
}

check_no_pr_ready() {
  local -a t=("$@")
  has_token_sequence gh pr ready -- "${t[@]:-}" || return 0
  deny "wt-tools: gh pr ready is blocked. The user marks PRs ready manually — automation does not. No bypass available."
}

check_no_pr_merge() {
  local -a t=("$@")
  has_token_sequence gh pr merge -- "${t[@]:-}" || return 0
  [[ -n "$bypass_merge" ]] && return 0
  deny "wt-tools: gh pr merge is blocked from automation. Prefix the command with WT_ALLOW_MERGE=1 to bypass for this single invocation."
}

check_no_force_remove() {
  local -a t=("$@")
  has_token_sequence git worktree remove -- "${t[@]:-}" || return 0
  [[ -n "$bypass_force" ]] && return 0
  has_token "--force" "${t[@]:-}" || return 0
  deny "wt-tools: git worktree remove --force is blocked (would destroy uncommitted work). Prefix the command with WT_ALLOW_FORCE=1 to bypass for this single invocation."
}

# inspect-wrapped: the outer command is bash/sh, the actual command-of-
# interest is inside a -c argument. Locate -c (supporting short-flag
# clusters like -lic), slice the tokens after it, strip outer quote chars
# left over from whitespace-tokenizing the quoted shell string, and re-run
# all four rule checks against the cleaned wrapped tokens. The env-var
# bypass detection happened at the outer command's front, so WT_ALLOW_*
# vars are honored automatically.
check_inspect_wrapped() {
  local -a t=("$@")
  [[ "${t[0]:-}" == "bash" || "${t[0]:-}" == "sh" ]] || return 0

  local i c_idx=-1
  for ((i=1; i<${#t[@]}; i++)); do
    if [[ "${t[i]}" == "-c" ]] || [[ "${t[i]}" =~ ^-[a-zA-Z]*c$ ]]; then
      c_idx=$i; break
    fi
  done
  (( c_idx == -1 )) && return 0

  local -a wrapped=("${t[@]:c_idx+1}")
  local -a cleaned=()
  local tok
  for tok in "${wrapped[@]:-}"; do
    tok="${tok#\"}"; tok="${tok#\'}"
    tok="${tok%\"}"; tok="${tok%\'}"
    cleaned+=("$tok")
  done

  check_draft_prs        "${cleaned[@]:-}"
  check_no_pr_ready      "${cleaned[@]:-}"
  check_no_pr_merge      "${cleaned[@]:-}"
  check_no_force_remove  "${cleaned[@]:-}"
}

# ---- apply rule ----------------------------------------------------------
case "$rule" in
  draft-prs)        check_draft_prs        "${tokens[@]:-}" ;;
  no-pr-ready)      check_no_pr_ready      "${tokens[@]:-}" ;;
  no-pr-merge)      check_no_pr_merge      "${tokens[@]:-}" ;;
  no-force-remove)  check_no_force_remove  "${tokens[@]:-}" ;;
  inspect-wrapped)  check_inspect_wrapped  "${tokens[@]:-}" ;;
  *)
    # Unknown rule: defer. install.sh should never wire this, but don't fail closed.
    exit 0
    ;;
esac

exit 0
